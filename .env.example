# Copy to .env and fill in. Do not commit .env.

# Model source: "wandb" pulls from the registry, "local" uses MODEL_LOCAL_PATH
MODEL_SOURCE=wandb
WANDB_API_KEY=
# Full registry reference, e.g. my-org/wandb-registry-model/taxi-fare-model:production
WANDB_MODEL_REF=

# AWS / DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE=taxi-fare-predictions
LOG_TO_DB=true
# Leave these blank on EC2 and use an IAM instance role instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
API_URL=http://api:8000

# Monitoring dashboard
MAE_ALERT_THRESHOLD=5.0
MIN_FEEDBACK_FOR_ALERT=10
DASHBOARD_PORT=8501
